POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=signalintel
POSTGRES_USER=signalintel_admin
POSTGRES_PASSWORD=password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALERTS_TOPIC=signal.alerts.v1
KAFKA_CONSUMER_GROUP=notifier-service
ALERTS_DLQ_TOPIC=signal.alerts.dlq
SCHEMA_VALIDATION_ENABLED=true

# Structured logging: "text" for human-readable local dev logs, "json" for
# log-aggregator-friendly output (Loki/CloudWatch/ELK) in staging/prod.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Distributed tracing (see tracing.py). Safe to leave enabled with no
# collector running -- spans are created but silently not exported.
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=notifier-service

EMAIL_ENABLED=false
EMAIL_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@signal-intel.local

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

WEBHOOK_ENABLED=false
CUSTOM_WEBHOOKS=

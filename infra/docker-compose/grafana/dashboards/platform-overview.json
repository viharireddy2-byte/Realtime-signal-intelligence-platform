{
  "title": "Signal Intelligence Platform — Overview",
  "uid": "signal-intel-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events produced / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(signal_events_produced_total{status=\"success\"}[1m]))",
          "legendFormat": "events/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "query-api p95 latency by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(query_api_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "query-api requests / sec by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(query_api_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active WebSocket live-feed clients",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "query_api_websocket_clients", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Anomalies processed / min by severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(notifier_alerts_processed_total[1m])) by (severity) * 60",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka consumer group lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis cache hit ratio (query-api KPI reads)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(query_api_cache_hits_total[5m])) / (sum(rate(query_api_cache_hits_total[5m])) + sum(rate(query_api_cache_misses_total[5m])))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    }
  ]
}

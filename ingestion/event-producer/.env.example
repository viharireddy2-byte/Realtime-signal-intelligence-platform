# Most producer settings are CLI flags (see README.md), not env vars --
# these are the ones that aren't.

EVENTS_DLQ_TOPIC=signal.events.dlq
SCHEMA_VALIDATION_ENABLED=true

# Structured logging: "text" for human-readable local dev logs, "json" for
# log-aggregator-friendly output (Loki/CloudWatch/ELK) in staging/prod.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Distributed tracing (see tracing.py). Safe to leave enabled with no
# collector running -- spans are created but silently not exported.
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=event-producer
